[Unit]
Description=Leyden Lightning sidecar (Spark)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leyden/lightning
EnvironmentFile=/home/ubuntu/.leyden/env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
