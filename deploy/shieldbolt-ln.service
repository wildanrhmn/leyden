[Unit]
Description=Shieldbolt Lightning sidecar (Spark)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/shieldbolt/lightning
EnvironmentFile=/home/ubuntu/.shieldbolt/env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
