SHIELDBOLT_ZEC_MNEMONIC=/home/ubuntu/.shieldbolt/zec.mnemonic
SHIELDBOLT_LWD=https://zec.rocks:443
SHIELDBOLT_LISTEN=127.0.0.1:8080
SHIELDBOLT_PUBLIC_URL=https://43-134-116-188.sslip.io
SHIELDBOLT_WEB=/home/ubuntu/shieldbolt/web
SHIELDBOLT_LN_URL=http://127.0.0.1:9737
